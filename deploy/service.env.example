# Resource-server configuration. User OAuth client secrets belong on the
# authorization server, not in this service.
DATABRICKS_HOST=https://workspace.cloud.databricks.com
DATABRICKS_ALLOWED_HOST_SUFFIXES=.cloud.databricks.com,.azuredatabricks.net,.gcp.databricks.com
PUBLIC_BASE_URL=https://mcp.example.com/databricks
MCP_SERVER_URL=https://mcp.example.com/databricks
# Use the public reverse-proxy hostname here; omit this variable for direct loopback use.
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_HOST_ORIGIN_PROTECTION=true
MCP_AUTH_ISSUER=https://auth.example.com
MCP_AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
MCP_AUTH_JWKS_SSRF_SAFE=true
MCP_AUTH_TOKEN_ENDPOINT=https://auth.example.com/token
MCP_AUTH_CONNECTOR=databricks
MCP_AUTH_CLIENT_ID=databricks-mcp-resource
MCP_AUTH_CLIENT_PRIVATE_KEY_FILE=/var/lib/mcp-resource-auth/private.pem
MCP_AUTH_CLIENT_KEY_ID_FILE=/var/lib/mcp-resource-auth/key_id
DATABRICKS_REQUIRED_GROUP=authorized_users
DATABRICKS_ALLOWED_WAREHOUSE_IDS=replace-with-approved-ids
# Shown to users in client UI when they authorize this server. Required, and
# rejected at startup if left on an example.com placeholder.
MCP_SERVER_WEBSITE=https://mcp.your-company.example/databricks
MCP_SERVER_DISPLAY_NAME=Databricks MCP
# Where the MCP endpoint is mounted below PUBLIC_BASE_URL. Also the token
# audience and the path the protected-resource metadata is published under,
# so the authorization server has to issue tokens for PUBLIC_BASE_URL+MCP_PATH.
MCP_PATH=/mcp
# Listen address; MCP_PORT must match whatever port is published and whatever
# MCP_ALLOWED_HOSTS says.
MCP_HOST=0.0.0.0
MCP_PORT=6328
MCP_LOG_LEVEL=info
# Query bounds. MCP_MAX_SAMPLE_ROWS is a ceiling on sample_table's caller
# supplied limit, never a floor.
MCP_MAX_ROWS=200
MCP_MAX_SAMPLE_ROWS=100
MCP_SQL_WAIT_TIMEOUT=10s
MCP_METRICS_ENABLED=true
MCP_METRICS_DB_PATH=/metrics/databricks-mcp-metrics.sqlite3
